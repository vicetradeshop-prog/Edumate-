{
  "name": "edumate",
  "version": "1.0.0",
  "private": true,
  "description": "EduMate — plateforme éducative tout-en-un : assistant IA, quiz, organisation, outils scolaires.",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build:data": "tsx scripts/build-catalog.ts",
    "build": "npm run build:data && npm run typecheck && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "build:tests": "vite build --config tests/vite.render.config.ts",
    "start": "node dist/server/index.js",
    "preview": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "scan": "node scripts/scan-secrets.mjs",
    "scan:all": "node scripts/scan-secrets.mjs --ignored",
    "test": "npm run test:unit && npm run test:content && npm run test:api",
    "test:unit": "tsx scripts/unit-test.ts",
    "test:content": "tsx scripts/check-content.ts",
    "test:api": "node scripts/smoke-test.mjs",
    "test:api:built": "node scripts/smoke-test.mjs --built",
    "test:db": "npm run test:storage && npm run test:e2e-db && npm run test:e2e-db:built && npm run test:e2e-db:badurl",
    "test:storage": "tsx scripts/test-upstash.mjs && tsx scripts/test-upstash.mjs unreachable",
    "test:e2e-db": "node scripts/e2e-upstash.mjs",
    "test:e2e-db:built": "node scripts/e2e-upstash.mjs --built",
    "test:e2e-db:badurl": "node scripts/e2e-upstash.mjs --built --badurl",
    "test:bundle": "node scripts/check-bundle.mjs",
    "test:modal": "tsx scripts/test-modal-focus.ts",
    "test:stars": "tsx scripts/test-stars.ts",
    "test:music": "tsx scripts/test-music.ts",
    "test:lessons": "tsx scripts/test-lessons.ts",
    "test:lessons-ui": "tsx scripts/test-lessons-ui.ts",
    "test:sw": "tsx scripts/test-sw.ts",
    "test:pwa": "tsx scripts/test-pwa.ts",
    "test:feed": "node scripts/test-feed.mjs",
    "test:feed-ui": "tsx scripts/test-feed-ui.ts",
    "test:whiteboard": "tsx scripts/test-whiteboard.ts",
    "test:routes": "node scripts/check-page.mjs --all",
    "test:render": "npm run build:tests && node scripts/render-test.mjs",
    "test:scripts": "python3 scripts/audit-scripts.py",
    "test:hooks": "python3 scripts/audit-hooks.py",
    "test:calendar": "tsx scripts/test-calendar-ui.ts",
    "test:ui": "tsx scripts/test-ui-regression.ts",
    "test:all": "npm run scan && npm run build && npm run test && npm run test:api:built && npm run test:db && npm run test:bundle && npm run test:modal && npm run test:stars && npm run test:music && npm run test:lessons && npm run test:lessons-ui && npm run test:sw && npm run test:pwa && npm run test:whiteboard && npm run test:feed-ui && npm run test:calendar && npm run test:ui && npm run test:feed && npm run test:render && npm run test:hooks",
    "icons": "node scripts/make-icons.mjs",
    "zip": "npm run scan && node scripts/make-zip.mjs"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "framer-motion": "^11.15.0",
    "katex": "^0.16.11",
    "lucide-react": "^0.503.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "three": "^0.186.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.2",
    "jsdom": "29.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "volta": {
    "node": "20.19.0"
  }
}
