# ============================================================
#  EduMate — Variables d'environnement
#  Copier ce fichier vers `.env` puis remplir les valeurs.
#  ⚠️ Ne jamais committer le fichier `.env` réel.
#
#  ✅ Ce fichier EST chargé automatiquement au démarrage du serveur
#     (src/server/lib/env.ts, sans dépendance externe). Il est lu depuis la
#     racine du projet, en `npm run dev` comme en `npm start`.
#     Une variable déjà définie dans l'environnement réel (Render, ligne de
#     commande) N'EST JAMAIS écrasée : la production garde toujours la priorité.
#     `.env.local` est lu en plus de `.env` et permet de surcharger localement.
# ============================================================

# --- Serveur -------------------------------------------------
# Port HTTP (Render injecte automatiquement PORT)
PORT=8787
# "production" ou "development"
NODE_ENV=development
# Origine(s) autorisée(s) pour les cookies cross-domaine (optionnel)
# Exemple : https://edumate.onrender.com
APP_URL=http://localhost:5173

# --- Base de données (Upstash Redis) --------------------------
# Console Upstash > Database > REST API
UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Facultatif : préfixe de clés pour partager une base entre environnements
UPSTASH_KEY_PREFIX=edumate
# Stockage de secours quand Upstash n'est pas configuré : "memory" ou "file"
# "file" écrit dans ./data/local (persistant en local, PAS sur Render)
FALLBACK_STORAGE=memory

# --- Sécurité -------------------------------------------------
# Secret de signature des tokens de session (longue chaîne aléatoire)
SESSION_SECRET=change-moi-avec-une-longue-chaine-aleatoire
# Durée de validité de la session (ex: 7d, 12h, 30m)
SESSION_MAX_AGE=7d
# Adresses e-mail autorisées à ouvrir la section Administration, séparées par
# des virgules. Le TOUT PREMIER compte créé sur une base vide devient aussi
# administrateur automatiquement. Laisser vide si ce premier compte te suffit.
ADMIN_EMAIL=

# --- Intelligence artificielle ---------------------------------
# 🔐 LA CLÉ NE DOIT JAMAIS ÊTRE ÉCRITE DANS LE CODE.
#    Ce fichier `.env` est ignoré par git : c'est le seul endroit où la mettre
#    en local. En production, elle se saisit dans Render → Environment.
#    Une clé committée sur GitHub est bloquée au push (erreur GH013) et reste
#    compromise à vie : à révoquer immédiatement.
#
# Sans clé, EduMate bascule sur le tuteur intégré hors-ligne (méthode pas à
# pas, rappels de cours, exercices générés) et sur MyMemory pour la traduction :
# l'application reste 100 % fonctionnelle.
#
# Fournisseur : "openai" | "groq" | "mistral" | "xai" | "none"
# Laisser vide = déduit automatiquement du format de la clé
# (gsk_... → groq, xai-... → xai, sk-... → openai). « grok » est accepté.
AI_PROVIDER=groq
# Clé d'API (obligatoire pour activer l'IA) — Groq : https://console.groq.com
AI_API_KEY=
# Modèles (valeurs par défaut si vides)
# Groq : openai/gpt-oss-120b | OpenAI : gpt-4o-mini
# Mistral : mistral-large-latest | xAI : grok-4-fast
AI_MODEL=
# URL de base (utile pour un proxy/serveur compatible OpenAI)
AI_BASE_URL=
# Token max par réponse
AI_MAX_TOKENS=900

# --- E-mails (« Mot de passe oublié ») ---------------------------
# 🔐 Comme pour l'IA : la clé se met ICI en local, et dans Render →
#    Environment en production. JAMAIS dans un fichier du dépôt.
#
# Sans configuration, EduMate ne plante pas et ne bloque personne : le lien de
# réinitialisation est écrit dans les JOURNAUX du serveur (Render → Logs), et
# l'API répond 200 exactement comme si l'e-mail était parti.
#
# Fournisseur : "resend" | "brevo" | "sendgrid" | "mailgun" | "postmark" |
#               "smtp" | "log" | "none"
# Vide = déduit du FORMAT de la clé (re_... → resend, xkeysib-... → brevo,
# SG.... → sendgrid, key-... → mailgun). « sendinblue » est accepté pour brevo.
# 👉 Sur Render, laisse VIDE et renseigne seulement MAIL_API_KEY.
#
# ⚠️ Expéditeur @gmail.com : impossible d'authentifier ce domaine (SPF/DKIM),
#    donc une partie des messages finira en indésirables. SendGrid permet de
#    VÉRIFIER une adresse Gmail (lien de confirmation reçu sur la boîte) et s'en
#    sort nettement mieux que Brevo dans ce cas. Pour un envoi fiable il faut un
#    domaine à toi (~10 €/an) : voir docs/MOT-DE-PASSE-OUBLIE.md.
MAIL_PROVIDER=
# Clé d'API du fournisseur (inutile en mode smtp)
MAIL_API_KEY=
# Expéditeur : le domaine DOIT être vérifié chez le fournisseur, sinon les
# messages partent en spam ou sont refusés.
MAIL_FROM=EduMate <no-reply@mon-domaine.fr>
MAIL_FROM_NAME=EduMate
# Adresse de réponse (facultatif) : celle que tu lis vraiment
MAIL_REPLY_TO=

# --- E-mails via SMTP (Gmail, OVH, Infomaniak, Outlook…) ---------
# 🔴 INUTILISABLE SUR RENDER (plan gratuit) : depuis septembre 2025, Render
#    bloque le trafic SORTANT vers les ports SMTP 25, 465 et 587. La connexion
#    expire sans message d'erreur explicite. Sur Render, passe par une API
#    HTTPS (MAIL_PROVIDER=brevo / sendgrid / resend). Le SMTP reste pertinent
#    en local, sur un VPS, ou sur un plan Render payant.
#    EduMate détecte ce piège et l'affiche au démarrage et dans /admin.
#
# Utilisé seulement si MAIL_PROVIDER=smtp (ou si une clé est absente et que
# SMTP_HOST est renseigné). Avec Gmail : activer la validation en deux étapes
# puis créer un « mot de passe d'application » (jamais le mot de passe du compte).
#   Gmail   : smtp.gmail.com   port 465 (SMTP_SECURE=true)
#   OVH     : ssl0.ovh.net     port 465 (SMTP_SECURE=true)
#   Outlook : smtp.office365.com port 587 (SMTP_SECURE=false → STARTTLS)
SMTP_HOST=
SMTP_PORT=587
# true = connexion chiffrée d'emblée (port 465) ; false = STARTTLS (port 587).
# Vide = déduit du port (465 → true).
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Mailgun uniquement : le domaine déclaré dans la console (ex. mg.mon-domaine.fr)
MAILGUN_DOMAIN=
# Délai maximal d'un envoi, en millisecondes (un e-mail lent ne doit jamais
# bloquer la requête HTTP de l'élève)
MAIL_TIMEOUT_MS=10000

# --- Réinitialisation de mot de passe -----------------------------
# Durée de validité du lien, en minutes (bornée entre 5 et 1440)
PASSWORD_RESET_TTL_MINUTES=30
# Chemin de la page « nouveau mot de passe » (doit correspondre à la route React)
PASSWORD_RESET_PATH=/reinitialiser
# Délai minimal entre deux demandes pour une même adresse, en secondes
PASSWORD_RESET_COOLDOWN_SECONDS=60
# Plafond de demandes par adresse et par heure (anti-harcèlement)
PASSWORD_RESET_MAX_PER_HOUR=5
# Renvoie le lien dans la réponse HTTP. FORCÉ À FALSE en production, quelle que
# soit cette valeur : ce réglage permettrait de prendre le contrôle de n'importe
# quel compte. Utile uniquement en développement local.
EXPOSE_RESET_LINK=false

# --- Dépannage d'urgence (mot de passe perdu, sans e-mail) --------
# 🔑 SERT AUSSI À RÉCUPÉRER UN COMPTE ADMINISTRATEUR BLOQUÉ.
#
# Au démarrage, le serveur remplace le mot de passe du compte RECOVERY_EMAIL,
# ferme toutes ses sessions, puis journalise l'opération. Sur Render : poser
# ces variables → redéployer → se connecter → SUPPRIMER les variables.
#
# ⚠️ Tant qu'elles sont présentes, ce mot de passe est réappliqué à CHAQUE
#    démarrage et écraserait tout changement fait depuis l'interface.
#    Le mot de passe doit respecter la politique de l'application
#    (8 caractères minimum, une lettre, un chiffre).
RECOVERY_EMAIL=
RECOVERY_PASSWORD=
# true = (re)donne le rôle administrateur à ce compte
RECOVERY_MAKE_ADMIN=false

# --- Services externes -----------------------------------------
# Traduction : assurée d'abord par l'IA si une clé est configurée ;
# MyMemory (gratuit, sans clé) sert de repli automatique.
TRANSLATE_PROVIDER=mymemory
# Recherche de lycées : annuaire open data de l'Éducation nationale (gratuit, sans clé)
SCHOOLS_PROVIDER=dataeducation

# --- Mode démo -------------------------------------------------
# Compte de démonstration partagé (« Camille », via /api/auth/demo).
# DÉSACTIVÉ par défaut : sur une instance réelle, ce compte anonyme mélange la
# progression de tous les visiteurs. Ne l'active que pour une démo ponctuelle.
# À false, un compte démo déjà présent en base est supprimé au démarrage.
ALLOW_DEMO_ACCOUNT=false
